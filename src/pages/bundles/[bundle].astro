---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import { books, bookBundles } from '../../data/books';

export function getStaticPaths() {
  return [
    { params: { bundle: 'seeker' } },
    { params: { bundle: 'believer' } },
    { params: { bundle: 'kids' } },
    { params: { bundle: 'master' } }
  ];
}

const { bundle } = Astro.params;

const bundleMap: Record<string, {
  title: string;
  subtitle: string;
  seriesKey: string;
  bundleId: string;
  shopUrl: string;
  heroGradient: string;
}> = {
  seeker: {
    title: 'The Complete Spiritual Seeker Collection',
    subtitle: '25 Investigative Devotionals Unveiling the Ancient Blueprint',
    seriesKey: 'seeker',
    bundleId: 'bundle-the-seeker-collection',
    shopUrl: '/shop/seekers',
    heroGradient: 'from-[#0A1128] via-[#001F54] to-[#0A1128]'
  },
  believer: {
    title: 'The Complete New Believer Collection',
    subtitle: '25 Foundational Devotionals Rooted in Faith & Spiritual Growth',
    seriesKey: 'believer',
    bundleId: 'bundle-the-new-believer-collection',
    shopUrl: '/shop/believers',
    heroGradient: 'from-[#1A4314] via-[#2D5A27] to-[#1A4314]'
  },
  kids: {
    title: "The Complete Children's Edition Collection",
    subtitle: '25 Engaging Prophecy Detective & Discovery Adventures for Kids',
    seriesKey: 'kids',
    bundleId: 'bundle-the-childrens-edition-collection',
    shopUrl: '/shop/kids',
    heroGradient: 'from-[#6B2D5C] via-[#8E3B75] to-[#6B2D5C]'
  },
  master: {
    title: 'The Ultimate Divine Blueprint Master Library',
    subtitle: 'All 75 Ebooks Across The Seeker, Believer & Children\'s Collections',
    seriesKey: 'all',
    bundleId: 'bundle-the-master-library-75-books',
    shopUrl: '/shop',
    heroGradient: 'from-[#0A1128] via-[#1E3A8A] to-[#D4AF37]'
  }
};

const currentBundleMeta = bundleMap[bundle] || bundleMap.seeker;
const bundleData = bookBundles.find(b => b.id === currentBundleMeta.bundleId);

const bundleBooks = currentBundleMeta.seriesKey === 'all'
  ? books
  : books.filter(b => b.audience === currentBundleMeta.seriesKey);
---

<BaseLayout
  title={`${currentBundleMeta.title} | Library & Download Portal`}
  description={`Direct reader access and downloads for ${currentBundleMeta.title}. Lifetime access to all ${bundleBooks.length} books in the collection.`}
>
  <!-- Hero Section -->
  <header class={`relative bg-gradient-to-br ${currentBundleMeta.heroGradient} text-white py-16 px-4 sm:px-6 lg:px-8 border-b-4 border-[#D4AF37]`}>
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row items-center gap-8">
        {bundleData && (
          <div class="w-48 sm:w-56 shrink-0 shadow-2xl rounded-xl overflow-hidden border-2 border-[#D4AF37]">
            <img
              src={bundleData.coverImage}
              alt={bundleData.name}
              class="w-full h-auto object-cover"
            />
          </div>
        )}
        <div class="text-center md:text-left flex-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D4AF37]/20 border border-[#D4AF37] text-[#D4AF37] text-xs font-semibold uppercase tracking-wider mb-4">
            <span>Official Bundle Access</span>
            <span>*</span>
            <span>{bundleBooks.length} Books Included</span>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-playfair font-bold text-white mb-3">
            {currentBundleMeta.title}
          </h1>
          <p class="text-base sm:text-lg text-gray-200 max-w-2xl font-inter mb-6">
            {currentBundleMeta.subtitle}
          </p>
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-4">
            <a
              href="#library-grid"
              class="inline-flex items-center gap-2 bg-[#D4AF37] text-[#0A1128] font-bold px-6 py-3 rounded-lg shadow-lg hover:bg-yellow-400 transition"
            >
              Access Library ({bundleBooks.length} Books)
            </a>
            <a
              href={currentBundleMeta.shopUrl}
              class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-medium px-5 py-3 rounded-lg border border-white/20 transition"
            >
              Browse in Shop
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Access Status Banner -->
  <section class="bg-[#F8F9FA] border-b border-gray-200 py-4 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-sm">
      <div class="flex items-center gap-2 text-gray-700">
        <span class="w-3 h-3 rounded-full bg-green-500 inline-block animate-pulse"></span>
        <span class="font-semibold text-[#0A1128]">Collection Access:</span>
        <span id="access-status-text" class="text-gray-600">Lifetime access enabled for this device.</span>
      </div>
      <div class="text-xs text-gray-500 font-inter">
        Author: <span class="font-medium text-gray-700">Christine A.</span> | Publisher: <span class="font-medium text-gray-700">CSA Ministry & Publishing</span>
      </div>
    </div>
  </section>

  <!-- Books Grid -->
  <main id="library-grid" class="max-w-6xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-playfair font-bold text-[#0A1128]">
          Your {bundleBooks.length} Books
        </h2>
        <p class="text-sm text-gray-600 font-inter mt-1">
          Click any book below to open the interactive reader, listen to audio narration, or download the full PDF.
        </p>
      </div>
      <div class="text-xs text-[#D4AF37] font-semibold uppercase tracking-wider bg-[#0A1128] px-3 py-1.5 rounded-lg self-start sm:self-auto">
        Complete Library
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {bundleBooks.map((book) => (
        <BookCard book={book} />
      ))}
    </div>
  </main>

  <!-- Access Storage Script -->
  <script is:inline>
    (function() {
      const urlParams = new URLSearchParams(window.location.search);
      const unlockCode = urlParams.get('unlock');
      if (unlockCode) {
        localStorage.setItem('csa_bundle_unlocked', unlockCode);
        localStorage.setItem('csa_unlocked_at', new Date().toISOString());
      }
    })();
  </script>
</BaseLayout>
