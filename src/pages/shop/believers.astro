---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import { getBooksByAudience } from '../../data/books';

const believerBooks = getBooksByAudience('believer');
const sampleBook = believerBooks[0];
---
<BaseLayout
  title="The New Believer Collection | Welcome to the Family. Let's Build Your Foundation."
  description="Christian books for new believers by Christine A. Simple, grace-filled, 5-minute daily readings that reveal Jesus in the Old Testament without confusing jargon."
  keywords="Christian books for new believers, Understanding the Bible, Grace-based books, You Can Trust the Bible, From Ritual to Relationship"
>
  <!-- [Hero Section] -->
  <section class="bg-[#0A1128] text-white py-24 px-6 border-b-4 border-[#6B8E7B]">
    <div class="max-w-4xl mx-auto text-center">
      <span class="inline-block font-montserrat text-xs font-bold uppercase tracking-widest text-[#8FBC8F] bg-[#6B8E7B]/20 border border-[#6B8E7B]/40 px-4 py-1.5 rounded-full mb-6">
        Target Group 2 &bull; The New Believer Collection
      </span>
      <h1 class="font-playfair text-4xl sm:text-5xl md:text-6xl font-bold mb-6 leading-tight">
        Welcome to the Family. <span class="text-[#8FBC8F]">Let's Build Your Foundation.</span>
      </h1>
      <p class="font-playfair italic text-xl md:text-2xl text-gray-200 mb-6">
        For the new Christian, the returning believer, and the person building their faith from the ground up.
      </p>
      <p class="font-inter text-base md:text-lg text-gray-300 max-w-2xl mx-auto leading-relaxed mb-10">
        If you just made the decision to follow Jesus, welcome! You might feel excited but also a little overwhelmed. Maybe you opened the Bible to page one and got stuck in the middle of ancient laws and confusing stories. We have good news for you: <strong>The entire Bible is a rescue story, and you are the one being rescued.</strong>
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a
          href="#believer-books"
          class="min-h-[48px] inline-flex items-center justify-center bg-[#6B8E7B] text-white px-8 py-4 rounded-full font-montserrat font-bold hover:bg-white hover:text-[#0A1128] transition-colors"
        >
          Shop the New Believer Collection
        </a>
        <a
          href="#believer-excerpt"
          class="min-h-[48px] inline-flex items-center justify-center border border-[#8FBC8F] text-[#8FBC8F] px-8 py-4 rounded-full font-montserrat font-bold hover:bg-[#6B8E7B] hover:text-white transition-colors"
        >
          Read an Excerpt
        </a>
      </div>
    </div>
  </section>

  <!-- [Section 2: Why These Books are Different for You] -->
  <section class="py-24 px-6 max-w-5xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="font-playfair text-3xl md:text-5xl font-bold text-[#0A1128] mb-6">
        Simple. Grace-Filled. Encouraging.
      </h2>
      <p class="font-inter text-lg text-gray-700 leading-relaxed">
        You do not need a theology degree to know Jesus. These books are designed for you. They take the deep, intimidating truths of the Old Testament and break them down into warm, easy-to-understand daily readings.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-12">
      <div class="bg-white p-8 rounded-2xl shadow-sm border-t-4 border-[#6B8E7B]">
        <h3 class="font-playfair text-xl font-bold text-[#0A1128] mb-3">&bull; 5-Minute Readings</h3>
        <p class="font-inter text-sm text-gray-600 leading-relaxed">
          Perfect for busy schedules. No stress, no heavy academic terms - just steady, daily spiritual growth.
        </p>
      </div>
      <div class="bg-white p-8 rounded-2xl shadow-sm border-t-4 border-[#6B8E7B]">
        <h3 class="font-playfair text-xl font-bold text-[#0A1128] mb-3">&bull; Grace Over Rules</h3>
        <p class="font-inter text-sm text-gray-600 leading-relaxed">
          We focus on what Jesus did for you on the cross, not on religious checklists or trying to earn God's approval.
        </p>
      </div>
      <div class="bg-white p-8 rounded-2xl shadow-sm border-t-4 border-[#6B8E7B]">
        <h3 class="font-playfair text-xl font-bold text-[#0A1128] mb-3">&bull; Build Unshakeable Trust</h3>
        <p class="font-inter text-sm text-gray-600 leading-relaxed">
          Learn to trust the Bible and its promises through clear, simple proof that God always keeps His Word.
        </p>
      </div>
    </div>

    <!-- Sample Excerpt Box -->
    <div id="believer-excerpt" class="bg-white rounded-3xl p-8 md:p-12 border-2 border-[#6B8E7B]/40 shadow-lg">
      <span class="font-montserrat text-xs font-bold uppercase tracking-widest text-[#6B8E7B] block mb-2">
        Sample 5-Minute Daily Reading &bull; From "{sampleBook.title}"
      </span>
      <h3 class="font-playfair text-2xl md:text-3xl font-bold text-[#0A1128] mb-2">{sampleBook.sampleDayTitle}</h3>
      <p class="font-inter text-xs font-semibold text-[#6B8E7B] mb-6">{sampleBook.sampleScripture}</p>
      <p class="font-inter text-gray-700 leading-relaxed mb-6 italic">
        "{sampleBook.sampleExcerpt}"
      </p>
      <div class="bg-[#6B8E7B]/10 p-4 rounded-xl text-sm text-[#0A1128]">
        <strong>{sampleBook.sampleReflectionOrActivity}</strong>
      </div>
    </div>
  </section>

  <!-- [Section 3: Featured New Believer Books (All 5 Books)] -->
  <section id="believer-books" class="py-24 px-6 bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="font-montserrat text-xs font-bold uppercase tracking-widest text-[#6B8E7B] block mb-2">
          Complete 5-Book New Believer Series
        </span>
        <h2 class="font-playfair text-3xl md:text-5xl font-bold text-[#0A1128] mb-4">
          Start Your Journey
        </h2>
        <p class="font-inter text-gray-600">
          All 5 books in the New Believer Collection by Christine A. Available in Paperback and Ebook.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {believerBooks.map((book) => (
          <BookCard book={book} accentColor="bg-[#6B8E7B]" />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>