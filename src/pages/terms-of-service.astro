---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR_NAME } from '../data/books';
---
<BaseLayout
  title="Terms of Service"
  description="Terms of Service for CSASHOPONLINE (csashoponline.com)."
>
  <section class="py-20 px-6 max-w-3xl mx-auto">
    <h1 class="font-playfair text-4xl font-bold text-[#0A1128] mb-6">Terms of Service</h1>
    <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 space-y-6 font-inter text-gray-700 leading-relaxed">
      <p>
        Welcome to <strong>CSASHOPONLINE (csashoponline.com)</strong>. By accessing this website and purchasing or downloading books from the Divine Blueprint Series by {AUTHOR_NAME}, you agree to these terms.
      </p>
      <h2 class="font-playfair text-2xl font-bold text-[#0A1128]">Intellectual Property</h2>
      <p>
        All book texts, titles, study guides, activity pages, and cover designs in the Divine Blueprint Series are the copyrighted property of {AUTHOR_NAME} / CSASHOPONLINE. You are welcome to share short quotes and excerpts with attribution, but full digital redistribution without permission is prohibited.
      </p>
      <h2 class="font-playfair text-2xl font-bold text-[#0A1128]">External Links</h2>
      <p>
        For your convenience, our book pages provide links to third-party bookstores including Amazon Books and Google Books. Purchases made on those platforms are governed by their respective terms and privacy policies.
      </p>
    </div>
  </section>
</BaseLayout>