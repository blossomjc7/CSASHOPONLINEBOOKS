---
interface Props {
  title: string;
  subtitle: string;
  vibe: string;
  description: string;
  color: string;
  badgeBg: string;
  btnColor: string;
  btnTextColor?: string;
  buttonText: string;
  link: string;
  coverPreview: string;
}

const {
  title,
  subtitle,
  vibe,
  description,
  color,
  badgeBg,
  btnColor,
  btnTextColor = 'text-white',
  buttonText,
  link,
  coverPreview,
} = Astro.props;
---
<div class={`bg-white p-8 rounded-2xl shadow-lg border-t-4 ${color} flex flex-col h-full hover:-translate-y-2 transition-all duration-300 border-x border-b border-gray-100`}>
  <!-- Top Mini Cover + Audience Header -->
  <div class="flex items-center gap-4 mb-6">
    <a href={link} class="shrink-0 w-16 h-24 rounded-md overflow-hidden shadow-md block hover:opacity-90 transition-opacity">
      <img
        src={coverPreview}
        alt={`Sample cover for ${title}`}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </a>
    <div>
      <span class={`inline-block text-[11px] font-montserrat font-bold uppercase tracking-wider px-3 py-1 rounded-full ${badgeBg} mb-1.5`}>
        5-Book Series
      </span>
      <h3 class="font-playfair text-2xl font-bold text-[#0A1128] leading-snug">{title}</h3>
      <p class="font-inter text-xs text-[#6C757D] mt-0.5">{subtitle}</p>
    </div>
  </div>

  <!-- The Vibe Quote -->
  <div class="bg-[#F8F9FA] rounded-xl p-4 mb-5 border-l-4 border-[#0A1128]/20">
    <p class="font-montserrat text-[11px] uppercase tracking-wider text-[#6C757D] font-bold mb-1">The Vibe</p>
    <p class="font-playfair italic text-base text-[#0A1128] font-semibold">"{vibe}"</p>
  </div>

  <!-- Why You'll Love It -->
  <div class="mb-8 flex-grow">
    <p class="font-montserrat text-xs uppercase tracking-wider text-[#0A1128] font-bold mb-2">Why You Will Love It:</p>
    <p class="font-inter text-gray-600 text-sm leading-relaxed">{description}</p>
  </div>

  <!-- CTA Button (min 48px height for mobile) -->
  <a
    href={link}
    class={`${btnColor} ${btnTextColor} min-h-[48px] flex items-center justify-center text-center px-6 py-3.5 rounded-full font-montserrat text-sm font-bold hover:opacity-90 transition-opacity shadow-sm`}
  >
    {buttonText}
  </a>
</div>