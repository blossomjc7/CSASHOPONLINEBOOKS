---
const currentYear = new Date().getFullYear();
---
<footer class="bg-[#0A1128] text-white pt-20 pb-12 px-6 border-t border-[#D4AF37]/20">
  <div class="max-w-7xl mx-auto">
    <!-- Top Gospel Reminder Banner -->
    <div class="bg-white/5 border border-[#D4AF37]/30 rounded-2xl p-8 mb-16 text-center max-w-4xl mx-auto">
      <p class="font-playfair italic text-xl md:text-2xl text-[#D4AF37] mb-2">
        "Our ultimate goal is not to sell books. It is to point you to a deeper, personal relationship with Jesus."
      </p>
      <p class="font-inter text-sm text-gray-300">
        - Christine A., Creator of The Divine Blueprint Series
      </p>
    </div>

    <div class="grid md:grid-cols-4 gap-10 pb-12 border-b border-white/10">
      <!-- Brand Column -->
      <div class="space-y-4">
        <a href="/" class="font-playfair text-3xl font-bold text-white tracking-wider">
          CSA<span class="text-[#D4AF37]">.</span>
        </a>
        <p class="font-inter text-sm text-gray-300 leading-relaxed">
          <strong>One Message. Three Audiences. The Same Savior.</strong> 30-day biblical journeys revealing Jesus in the Old Testament.
        </p>
        <p class="font-montserrat text-xs text-[#D4AF37] uppercase tracking-wider">
          Available On:
        </p>
        <p class="font-inter text-xs text-gray-300">
          Our Website (csaonlineshop.com), Google Books, and Amazon Books.
        </p>
      </div>

      <!-- Shop Collections -->
      <div>
        <h3 class="font-montserrat text-sm font-bold uppercase tracking-wider text-[#D4AF37] mb-4">
          Shop by Path
        </h3>
        <ul class="space-y-3 font-inter text-sm text-gray-300">
          <li>
            <a href="/shop/seekers/" class="hover:text-[#D4AF37] transition-colors flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#D4AF37]"></span>
              The Seeker Collection
            </a>
          </li>
          <li>
            <a href="/shop/believers/" class="hover:text-[#6B8E7B] transition-colors flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#6B8E7B]"></span>
              The New Believer Collection
            </a>
          </li>
          <li>
            <a href="/shop/kids/" class="hover:text-[#4A90E2] transition-colors flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#4A90E2]"></span>
              The Children Collection (Ages 4-8)
            </a>
          </li>
          <li>
            <a href="/shop/" class="hover:text-white underline text-xs pt-2 inline-block">
              Choose Your Journey &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- About & Ministry -->
      <div>
        <h3 class="font-montserrat text-sm font-bold uppercase tracking-wider text-[#D4AF37] mb-4">
          About
        </h3>
        <ul class="space-y-3 font-inter text-sm text-gray-300">
          <li><a href="/about/" class="hover:text-[#D4AF37] transition-colors">Our Story &amp; Mission</a></li>
          <li><a href="/author/" class="hover:text-[#D4AF37] transition-colors">About Christine A.</a></li>
          <li><a href="/press-kit/" class="hover:text-[#D4AF37] transition-colors">Press &amp; Media Kit</a></li>
          <li><a href="/contact/" class="hover:text-[#D4AF37] transition-colors">Contact Us</a></li>
        </ul>
      </div>

      <!-- Connect & Support -->
      <div>
        <h3 class="font-montserrat text-sm font-bold uppercase tracking-wider text-[#D4AF37] mb-4">
          Connect
        </h3>
        <ul class="space-y-3 font-inter text-sm text-gray-300 mb-6">
          <li>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#D4AF37] transition-colors">
              Instagram
            </a>
          </li>
          <li>
            <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#D4AF37] transition-colors">
              TikTok
            </a>
          </li>
          <li>
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#D4AF37] transition-colors">
              Facebook
            </a>
          </li>
        </ul>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center min-h-[44px] px-5 py-2 rounded-full border border-[#D4AF37] text-[#D4AF37] font-montserrat text-xs font-bold hover:bg-[#D4AF37] hover:text-[#0A1128] transition-colors"
        >
          Send a Message
        </a>
      </div>
    </div>

    <!-- Bottom Legal & Copyright -->
    <div class="pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-400 font-inter">
      <p>&copy; {currentYear} CSAONLINESHOP (Christine A.). All rights reserved.</p>
      <div class="flex flex-wrap justify-center gap-6">
        <a href="/shipping-returns/" class="hover:text-white transition-colors">Shipping &amp; Returns</a>
        <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms-of-service/" class="hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>