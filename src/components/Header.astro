---
import { getBooksByAudience } from '../data/books';

const seekerBooks = getBooksByAudience('seeker');
const believerBooks = getBooksByAudience('believer');
const kidsBooks = getBooksByAudience('kids');
---
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md shadow-sm border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    <!-- Logo -->
    <a href="/" class="font-playfair text-2xl font-bold text-[#0A1128] tracking-wider flex items-center gap-1">
      CSA<span class="text-[#D4AF37]">.</span>
      <span class="hidden sm:inline-block font-montserrat text-[10px] uppercase tracking-widest text-[#6C757D] ml-2 border-l border-gray-200 pl-2">
        Divine Blueprint Series
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-8 font-montserrat text-sm font-semibold">
      <a href="/" class="hover:text-[#D4AF37] transition-colors py-2">Home</a>

      <!-- Shop Mega Dropdown (Three Path Hierarchy) -->
      <div class="relative group">
        <a href="/shop/" class="hover:text-[#D4AF37] transition-colors flex items-center py-2">
          Shop
          <svg class="w-4 h-4 ml-1 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>

        <!-- Dropdown Content -->
        <div class="absolute left-1/2 -translate-x-1/2 mt-0 pt-3 w-[680px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
          <div class="bg-white border border-gray-100 shadow-2xl rounded-2xl p-6 grid grid-cols-3 gap-6">
            <!-- Path 1: Seekers -->
            <div>
              <a href="/shop/seekers/" class="block font-bold text-[#D4AF37] hover:underline mb-2 text-sm border-b border-[#D4AF37]/30 pb-2">
                1. For the Seeker &rarr;
              </a>
              <ul class="space-y-1.5 text-xs font-inter font-normal text-gray-600">
                {seekerBooks.map((b) => (
                  <li>
                    <a href={`/books/${b.slug}/`} class="hover:text-[#0A1128] hover:font-medium block py-0.5">
                      &bull; {b.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Path 2: New Believers -->
            <div>
              <a href="/shop/believers/" class="block font-bold text-[#6B8E7B] hover:underline mb-2 text-sm border-b border-[#6B8E7B]/30 pb-2">
                2. For the New Believer &rarr;
              </a>
              <ul class="space-y-1.5 text-xs font-inter font-normal text-gray-600">
                {believerBooks.map((b) => (
                  <li>
                    <a href={`/books/${b.slug}/`} class="hover:text-[#0A1128] hover:font-medium block py-0.5">
                      &bull; {b.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Path 3: Children -->
            <div>
              <a href="/shop/kids/" class="block font-bold text-[#4A90E2] hover:underline mb-2 text-sm border-b border-[#4A90E2]/30 pb-2">
                3. For the Children &rarr;
              </a>
              <ul class="space-y-1.5 text-xs font-inter font-normal text-gray-600">
                {kidsBooks.map((b) => (
                  <li>
                    <a href={`/books/${b.slug}/`} class="hover:text-[#0A1128] hover:font-medium block py-0.5">
                      &bull; {b.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <a href="/about/" class="hover:text-[#D4AF37] transition-colors py-2">About</a>
      <a href="/author/" class="hover:text-[#D4AF37] transition-colors py-2">Author</a>
      <a href="/press-kit/" class="hover:text-[#D4AF37] transition-colors py-2">Press Kit</a>
      <a href="/contact/" class="hover:text-[#D4AF37] transition-colors py-2">Contact</a>
    </nav>

    <!-- Desktop CTA Button -->
    <a
      href="/shop/"
      class="hidden md:inline-flex items-center justify-center min-h-[48px] bg-[#0A1128] text-white px-6 py-2.5 rounded-full font-montserrat text-sm font-semibold hover:bg-[#D4AF37] hover:text-[#0A1128] transition-colors duration-300"
    >
      Explore Books
    </a>

    <!-- Mobile Hamburger Button (48px touch target) -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Toggle Menu"
      aria-expanded="false"
      class="md:hidden inline-flex items-center justify-center w-12 h-12 rounded-lg text-[#0A1128] hover:bg-gray-100 focus:outline-none"
    >
      <svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 px-6 py-6 space-y-4 font-montserrat">
    <a href="/" class="block py-3 text-base font-semibold text-[#0A1128] border-b border-gray-100">Home</a>
    <div class="py-2 border-b border-gray-100">
      <a href="/shop/" class="block text-base font-bold text-[#0A1128] mb-3">Shop by Path</a>
      <div class="space-y-2 pl-3">
        <a href="/shop/seekers/" class="block py-2.5 px-3 rounded-lg bg-[#0A1128]/5 text-[#B38F1D] font-bold text-sm">
          1. The Spiritual Seeker (5 Books)
        </a>
        <a href="/shop/believers/" class="block py-2.5 px-3 rounded-lg bg-[#6B8E7B]/10 text-[#6B8E7B] font-bold text-sm">
          2. The New Believer (5 Books)
        </a>
        <a href="/shop/kids/" class="block py-2.5 px-3 rounded-lg bg-[#4A90E2]/10 text-[#4A90E2] font-bold text-sm">
          3. The Children Edition Ages 4-8 (5 Books)
        </a>
      </div>
    </div>
    <a href="/about/" class="block py-3 text-base font-semibold text-[#0A1128] border-b border-gray-100">About Our Mission</a>
    <a href="/author/" class="block py-3 text-base font-semibold text-[#0A1128] border-b border-gray-100">Author (Christine A.)</a>
    <a href="/press-kit/" class="block py-3 text-base font-semibold text-[#0A1128] border-b border-gray-100">Press Kit</a>
    <a href="/contact/" class="block py-3 text-base font-semibold text-[#0A1128] border-b border-gray-100">Contact Us</a>
    <a
      href="/shop/"
      class="block text-center min-h-[48px] leading-[48px] bg-[#D4AF37] text-[#0A1128] rounded-full font-bold text-sm mt-4"
    >
      Choose Your Journey
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    if (isHidden) {
      menu?.classList.remove('hidden');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
    } else {
      menu?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }
  });
</script>