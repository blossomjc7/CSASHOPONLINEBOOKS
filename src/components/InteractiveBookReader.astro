---
import type { Book } from '../data/books';
import { AUTHOR_NAME } from '../data/books';

interface Props {
  book: Book;
}

const { book } = Astro.props;

const themeBg =
  book.audience === 'seeker'
    ? 'from-[#0A1128] to-[#162347] border-[#D4AF37]'
    : book.audience === 'believer'
    ? 'from-[#233D32] to-[#345949] border-[#6B8E7B]'
    : 'from-[#1B4B82] to-[#2968B0] border-[#F5A623]';

const initialPages = [
  {
    dayNum: 0,
    isFree: true,
    badge: `Concept ${book.conceptNumber} - ${book.conceptTitle}`,
    title: book.title,
    subtitle: book.subtitle,
    body: book.shortDescription,
    footer: 'Loading 30-Day Manuscript...',
  },
];
---

<section id="interactive-reader" class="py-16 px-6 bg-[#FAF9F6] border-y border-gray-200">
  <div class="max-w-6xl mx-auto">
    <!-- Top Header Bar with 6-Language Selector & Unlock Status -->
    <div class="bg-[#0A1128] text-white rounded-t-3xl p-6 md:px-8 border-b-4 border-[#D4AF37] flex flex-col md:flex-row items-center justify-between gap-4 shadow-lg">
      <div class="text-center md:text-left">
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5">
          <span class="text-2xl">📖</span>
          <h2 class="font-playfair text-2xl md:text-3xl font-bold text-white" id="idr-header-title">
            30-Day Interactive Ebook Reader &amp; Audio
          </h2>
          <span id="idr-access-badge" class="font-montserrat text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-[#D4AF37] text-[#0A1128]">
            Days 1–3 Free Preview
          </span>
        </div>
        <p class="font-inter text-xs sm:text-sm text-gray-300 mt-1" id="idr-header-sub">
          Read &amp; listen to the Introduction + Days 1–3 FREE in 6 languages! Unlock all 30 Days + Full PDF Ebook anytime.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <!-- 6-Language Selector -->
        <div class="bg-white/10 border border-[#D4AF37]/50 rounded-full px-4 py-2 flex items-center gap-2 shadow-inner">
          <span class="font-montserrat text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">Language:</span>
          <select id="idr-lang-select" class="bg-transparent text-white font-montserrat font-bold text-xs focus:outline-none cursor-pointer pr-1">
            <option value="en" class="text-[#0A1128]">🇺🇸 English</option>
            <option value="sv" class="text-[#0A1128]">🇸🇪 Svenska</option>
            <option value="de" class="text-[#0A1128]">🇩🇪 Deutsch</option>
            <option value="es" class="text-[#0A1128]">🇪🇸 Español</option>
            <option value="sw" class="text-[#0A1128]">🇹🇿 Kiswahili</option>
            <option value="fr" class="text-[#0A1128]">🇫🇷 Français</option>
          </select>
        </div>

        <!-- Auto-Read Toggle -->
        <label class="bg-white/10 border border-white/20 rounded-full px-3.5 py-2 flex items-center gap-2 cursor-pointer text-xs font-montserrat font-semibold">
          <input type="checkbox" id="idr-autoread" class="accent-[#D4AF37] w-4 h-4 cursor-pointer" />
          <span>Auto-Read</span>
        </label>

        <!-- Admin/Author Magic Link Generator Gate -->
        <button
          type="button"
          id="idr-admin-btn"
          class="bg-white/10 hover:bg-white/20 text-gray-200 border border-white/20 rounded-full px-3.5 py-2 text-xs font-montserrat font-bold flex items-center gap-1.5 transition-colors"
          title="Author / Parent Zone"
        >
          <span>🔒</span> <span class="hidden sm:inline">Author / Voice Zone</span>
        </button>
      </div>
    </div>

    <!-- Main Reader Body -->
    <div class="bg-white rounded-b-3xl shadow-xl border border-t-0 border-gray-200 p-6 md:p-10">
      <div class="grid lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Voice Controls, PDF Download & 30-Day Selector (4 cols) -->
        <div class="lg:col-span-4 space-y-5">
          <!-- Storyteller Audio Box -->
          <div class="bg-[#FAF9F6] border border-gray-200 rounded-2xl p-5">
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-montserrat text-xs font-bold uppercase tracking-wider text-[#0A1128] flex items-center gap-1.5">
                <span>🔊</span> <span id="idr-voice-box-title">Storyteller Audio</span>
              </h3>
              <span class="text-[10px] font-montserrat font-bold uppercase px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800">
                6 Languages 🌟
              </span>
            </div>

            <label class="block text-[11px] font-montserrat font-semibold text-gray-500 uppercase mb-1.5">
              Narrator Style
            </label>
            <select id="idr-voice-select" class="w-full bg-white border border-gray-300 rounded-xl px-3 py-2 text-xs font-montserrat font-semibold text-[#0A1128] mb-4 focus:outline-none focus:border-[#0A1128]">
              <option value="Kore">Kore (Warm &amp; Clear)</option>
              <option value="Zephyr">Zephyr (Gentle &amp; Reflective)</option>
              <option value="Fenrir">Fenrir (Deep &amp; Reverent)</option>
              <option value="Aoede">Aoede (Bright &amp; Expressive)</option>
            </select>

            <button
              type="button"
              id="idr-play-btn"
              class="w-full min-h-[48px] bg-[#0A1128] hover:bg-[#D4AF37] text-white hover:text-[#0A1128] font-montserrat font-bold text-sm rounded-full shadow-md transition-all flex items-center justify-center gap-2"
            >
              <span id="idr-play-icon">🔊</span>
              <span id="idr-play-label">Listen to This Day</span>
            </button>

            <p id="idr-audio-status" class="text-[11px] font-inter text-gray-500 text-center mt-3">
              Click "Listen to This Day" or "Tap to Listen" to hear narration in your chosen language!
            </p>
          </div>

          <!-- Official PDF Ebook Action Card -->
          <div class="bg-[#FAF9F6] border border-gray-200 rounded-2xl p-5">
            <div class="flex items-center justify-between mb-2">
              <span class="font-montserrat text-xs font-bold uppercase tracking-wider text-[#0A1128] flex items-center gap-1.5">
                <span>📄</span> Official PDF Ebook
              </span>
              <span id="idr-pdf-badge" class="text-[10px] font-montserrat font-bold uppercase px-2 py-0.5 rounded bg-amber-100 text-amber-800">
                🔒 Locked
              </span>
            </div>
            <p class="font-inter text-xs text-gray-600 mb-3">
              Want to read offline or print? Unlock the complete 30-day official PDF manuscript.
            </p>
            <button
              type="button"
              id="idr-pdf-btn"
              class="w-full min-h-[44px] bg-white hover:bg-[#0A1128] text-[#0A1128] hover:text-white border-2 border-[#0A1128] font-montserrat font-bold text-xs uppercase tracking-wider rounded-full transition-colors flex items-center justify-center gap-2"
            >
              <span id="idr-pdf-btn-icon">🔒</span>
              <span id="idr-pdf-btn-text">Unlock Full PDF Edition</span>
            </button>
          </div>

          <!-- 30-Day Chapter Navigator -->
          <div class="bg-[#FAF9F6] border border-gray-200 rounded-2xl p-5">
            <div class="flex items-center justify-between mb-3">
              <span class="font-montserrat text-[11px] font-bold uppercase tracking-wider text-gray-500">
                Jump to Any Day (30 Days):
              </span>
              <span class="text-[10px] font-montserrat font-semibold text-emerald-700">Days 1–3 Free</span>
            </div>
            <div id="idr-day-grid" class="grid grid-cols-5 gap-1.5 max-h-56 overflow-y-auto pr-1">
              <!-- Populated dynamically with Intro + Days 1..30 -->
            </div>
          </div>
        </div>

        <!-- Right: Interactive Flipbook Stage (8 cols) -->
        <div class="lg:col-span-8 flex flex-col items-center">
          <!-- Normal Reading View -->
          <div
            id="idr-card"
            class={`w-full min-h-[460px] sm:min-h-[520px] rounded-3xl bg-gradient-to-br ${themeBg} border-4 p-6 sm:p-10 text-white shadow-2xl flex flex-col justify-between relative transition-all duration-300`}
          >
            <!-- Top Badge & Page Counter -->
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/15 pb-4">
              <span id="idr-page-badge" class="font-montserrat text-[11px] font-bold uppercase tracking-widest text-[#D4AF37]">
                Loading...
              </span>
              <span id="idr-page-counter" class="font-montserrat text-xs font-bold bg-white/15 px-3 py-1 rounded-full">
                Day 1 of 30
              </span>
            </div>

            <!-- Center Scrollable Manuscript Content -->
            <div class="my-4 space-y-4 flex-grow flex flex-col justify-center">
              <h3 id="idr-page-title" class="font-playfair text-2xl sm:text-3xl font-bold leading-tight text-white">
                {book.title}
              </h3>
              <p id="idr-page-subtitle" class="font-playfair italic text-sm sm:text-base text-[#D4AF37]">
                {book.subtitle}
              </p>
              <div class="bg-white/10 backdrop-blur-sm border border-white/15 rounded-2xl p-5 sm:p-6 max-h-[340px] overflow-y-auto">
                <div id="idr-page-body" class="font-inter text-sm sm:text-base leading-relaxed text-gray-100 whitespace-pre-line">
                  {book.shortDescription}
                </div>
              </div>
            </div>

            <!-- Footer Bar inside Flipbook -->
            <div class="flex items-center justify-between border-t border-white/15 pt-4 text-xs font-montserrat text-gray-300">
              <span id="idr-page-footer">Days 1–3 Free Preview</span>
              <button type="button" id="idr-card-speak-btn" class="bg-[#D4AF37] text-[#0A1128] hover:bg-white px-4 py-1.5 rounded-full font-bold uppercase tracking-wider flex items-center gap-1.5 shadow transition-colors">
                <span id="idr-card-speak-icon">🔊</span> <span id="idr-card-speak-lbl">Tap to Listen</span>
              </button>
            </div>
          </div>

          <!-- Paywall / Magic Unlock View (Shown when clicking Day 4–30 or locked PDF before unlocking) -->
          <div
            id="idr-lock-card"
            class="hidden w-full min-h-[460px] sm:min-h-[520px] rounded-3xl bg-[#0A1128] border-4 border-[#D4AF37] p-8 sm:p-10 text-white shadow-2xl flex-col justify-between items-center text-center"
          >
            <div class="max-w-lg mx-auto my-auto space-y-5">
              <div class="w-16 h-16 rounded-full bg-[#D4AF37]/20 border-2 border-[#D4AF37] flex items-center justify-center mx-auto text-3xl">
                🔒
              </div>
              <span class="font-montserrat text-xs font-bold uppercase tracking-widest text-[#D4AF37] block">
                End of 3-Day Free Preview
              </span>
              <h3 class="font-playfair text-2xl sm:text-3xl font-bold text-white" id="idr-lock-heading">
                Unlock All 30 Days + Full Official PDF Ebook
              </h3>
              <p class="font-inter text-sm text-gray-300 leading-relaxed">
                You have enjoyed the free preview (Introduction + Days 1–3) of <strong>{book.title}</strong>! Purchase the Ebook ($14.99) to receive your instant <strong>Magic Unlock Link &amp; Code</strong> for Days 4–30, 6-Language Audio Narration, and the downloadable PDF Ebook.
              </p>

              <!-- Step 1: Buy Buttons -->
              <div class="pt-2 space-y-3">
                <a
                  href={book.directBuyUrl}
                  class="w-full min-h-[48px] bg-[#D4AF37] hover:bg-white text-[#0A1128] font-montserrat font-bold text-sm uppercase tracking-wider rounded-full shadow-lg transition-colors flex items-center justify-center px-6"
                >
                  Buy Ebook &amp; Get Instant Magic Link (${book.priceEbook}) &rarr;
                </a>
              </div>

              <!-- Step 2: Simple Magic Code Input (Zero Passwords/Accounts Needed!) -->
              <div class="bg-white/10 border border-white/20 rounded-2xl p-5 mt-6 text-left">
                <label class="block font-montserrat text-xs font-bold uppercase tracking-wider text-[#D4AF37] mb-2">
                  ✨ Have a Magic Unlock Code? Enter it once:
                </label>
                <div class="flex flex-col sm:flex-row gap-2">
                  <input
                    type="text"
                    id="idr-unlock-input"
                    placeholder="e.g. CSA-xxxx or Magic Code"
                    class="flex-grow bg-white text-[#0A1128] font-montserrat font-bold text-sm rounded-xl px-4 py-2.5 focus:outline-none"
                  />
                  <button
                    type="button"
                    id="idr-unlock-submit"
                    class="bg-emerald-600 hover:bg-emerald-500 text-white font-montserrat font-bold text-xs uppercase tracking-wider px-6 py-2.5 rounded-xl shadow transition-colors shrink-0"
                  >
                    Unlock Now 🔓
                  </button>
                </div>
                <p id="idr-unlock-msg" class="font-inter text-xs text-red-300 mt-2 hidden"></p>
              </div>

              <button
                type="button"
                id="idr-back-free-btn"
                class="font-montserrat text-xs font-semibold text-gray-400 hover:text-white underline pt-2"
              >
                &larr; Return to Free Sample Days (Days 1–3)
              </button>
            </div>
          </div>

          <!-- Next / Prev Day Flip Controls -->
          <div class="w-full flex items-center justify-between gap-4 mt-6 px-2">
            <button
              type="button"
              id="idr-prev-btn"
              class="min-h-[44px] px-5 rounded-full bg-gray-100 hover:bg-[#0A1128] text-[#0A1128] hover:text-white font-montserrat font-bold text-xs uppercase tracking-wider transition-colors disabled:opacity-40"
            >
              &larr; Previous Day
            </button>

            <span id="idr-translating-indicator" class="hidden font-montserrat text-xs font-bold text-[#B38F1D] animate-pulse">
              Translating into selected language... 🌍
            </span>

            <button
              type="button"
              id="idr-next-btn"
              class="min-h-[44px] px-5 rounded-full bg-[#D4AF37] hover:bg-[#0A1128] text-[#0A1128] hover:text-white font-montserrat font-bold text-xs uppercase tracking-wider transition-colors disabled:opacity-40"
            >
              Next Day &rarr;
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Author / Voice Admin Gate Modal -->
  <div id="idr-gate-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 md:p-8 border-4 border-[#D4AF37] shadow-2xl">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-4">
        <h3 class="font-playfair font-bold text-xl text-[#0A1128] flex items-center gap-2">
          <span>🔒</span> Author &amp; Voice Admin Gate
        </h3>
        <button type="button" id="idr-gate-close" class="text-gray-400 hover:text-gray-700 text-2xl font-bold">&times;</button>
      </div>

      <div id="idr-gate-step1">
        <p class="font-inter text-xs text-gray-600 mb-4">
          Solve this quick check to view Author Magic Links &amp; Cloud Voice Settings:
        </p>
        <div class="bg-[#FAF9F6] border border-gray-200 rounded-2xl p-4 text-center mb-4">
          <span id="idr-math-q" class="font-montserrat text-2xl font-black text-[#0A1128]">4 + 5 = ?</span>
        </div>
        <input
          type="number"
          id="idr-math-ans"
          placeholder="Enter answer"
          class="w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-center font-montserrat font-bold text-base mb-4 focus:outline-none focus:border-[#0A1128]"
        />
        <button
          type="button"
          id="idr-math-submit"
          class="w-full bg-[#0A1128] hover:bg-[#D4AF37] text-white hover:text-[#0A1128] font-montserrat font-bold text-xs uppercase tracking-wider py-3 rounded-full transition-colors"
        >
          Verify &amp; Open Admin
        </button>
      </div>

      <div id="idr-gate-step2" class="hidden space-y-4">
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 text-xs text-amber-950 space-y-2">
          <strong class="block uppercase tracking-wider text-[#0A1128]">✨ Buyer Magic Link &amp; Code for This Book:</strong>
          <p>Master Author Code (Unlocks any book): <code class="bg-white px-2 py-0.5 rounded font-bold">CSA2026</code></p>
          <p>Book-Specific Code: <code id="idr-admin-book-code" class="bg-white px-2 py-0.5 rounded font-bold">Loading...</code></p>
          <div>
            <span class="block text-[11px] font-semibold mb-1">1-Click Magic Unlock URL (Send to Buyers):</span>
            <input type="text" id="idr-admin-magic-url" readonly class="w-full bg-white border border-amber-300 rounded-lg px-2.5 py-1.5 text-[11px] font-mono" />
          </div>
          <button type="button" id="idr-admin-unlock-now" class="w-full bg-[#0A1128] text-[#D4AF37] font-montserrat font-bold text-xs py-2 rounded-xl mt-2">
            🔓 Unlock Full 30 Days &amp; PDF on This Device Now
          </button>
        </div>

        <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-4 text-xs text-emerald-900">
          <strong>🎙️ Cloud Voice Engine Active:</strong> Multi-language TTS is automatically powered by Cloudflare Serverless Functions (`/api/swahili-tts`) with native device fallback.
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ bookSlug: book.slug, initialPages }}>
  document.addEventListener('DOMContentLoaded', async () => {
    let pagesData = initialPages;
    const translatedCache = {};
    let currentLang = 'en';
    let currentPage = 0;
    let isPlaying = false;
    let isUnlocked = false;
    let pdfDownloadUrl = `/manuscripts/pdfs/${bookSlug}.pdf`;
    const audioPlayer = new Audio();
    let sentenceQueue = [];
    let sentenceIndex = 0;

    const storageKey = `csa_unlocked_${bookSlug}`;
    const masterStorageKey = `csa_unlocked_all`;

    const langSelect = document.getElementById('idr-lang-select');
    const autoReadCheck = document.getElementById('idr-autoread');
    const playBtn = document.getElementById('idr-play-btn');
    const playIcon = document.getElementById('idr-play-icon');
    const playLabel = document.getElementById('idr-play-label');
    const audioStatus = document.getElementById('idr-audio-status');
    const prevBtn = document.getElementById('idr-prev-btn');
    const nextBtn = document.getElementById('idr-next-btn');
    const card = document.getElementById('idr-card');
    const cardSpeakBtn = document.getElementById('idr-card-speak-btn');
    const cardSpeakIcon = document.getElementById('idr-card-speak-icon');
    const cardSpeakLbl = document.getElementById('idr-card-speak-lbl');
    const lockCard = document.getElementById('idr-lock-card');
    const translatingIndicator = document.getElementById('idr-translating-indicator');
    const accessBadge = document.getElementById('idr-access-badge');

    const pdfBadge = document.getElementById('idr-pdf-badge');
    const pdfBtn = document.getElementById('idr-pdf-btn');
    const pdfBtnIcon = document.getElementById('idr-pdf-btn-icon');
    const pdfBtnText = document.getElementById('idr-pdf-btn-text');

    const badgeEl = document.getElementById('idr-page-badge');
    const counterEl = document.getElementById('idr-page-counter');
    const titleEl = document.getElementById('idr-page-title');
    const subtitleEl = document.getElementById('idr-page-subtitle');
    const bodyEl = document.getElementById('idr-page-body');
    const footerEl = document.getElementById('idr-page-footer');
    const dayGrid = document.getElementById('idr-day-grid');

    const unlockInput = document.getElementById('idr-unlock-input');
    const unlockSubmit = document.getElementById('idr-unlock-submit');
    const unlockMsg = document.getElementById('idr-unlock-msg');
    const backFreeBtn = document.getElementById('idr-back-free-btn');

    const uiLabels = {
      en: { listen: 'Listen to This Day', tap: 'Tap to Listen', stop: 'Stop Audio', speaking: 'Narrator is reading in English...', ended: 'Finished reading. Click Next Day to continue!', prev: '← Previous Day', next: 'Next Day →' },
      sv: { listen: 'Lyssna på denna dag', tap: 'Klicka för att lyssna', stop: 'Stoppa ljud', speaking: 'Berättaren läser på svenska...', ended: 'Uppläsning klar. Klicka på Nästa dag!', prev: '← Föregående dag', next: 'Nästa dag →' },
      de: { listen: 'Diesen Tag anhören', tap: 'Tippen zum Anhören', stop: 'Audio stoppen', speaking: 'Erzähler liest auf Deutsch...', ended: 'Fertig gesprochen. Nächster Tag!', prev: '← Vorheriger Tag', next: 'Nächster Tag →' },
      es: { listen: 'Escuchar este día', tap: 'Toca para escuchar', stop: 'Detener audio', speaking: 'El narrador lee en español...', ended: 'Lectura terminada. ¡Siguiente día!', prev: '← Día anterior', next: 'Siguiente día →' },
      sw: { listen: 'Sikiliza Siku Hii', tap: 'Gusa Kusikiliza', stop: 'Simamisha Sauti', speaking: 'Msimulizi anasoma kwa Kiswahili...', ended: 'Amemaliza kusoma. Siku inayofuata!', prev: '← Siku Iliyopita', next: 'Siku Inayofuata →' },
      fr: { listen: 'Écouter ce jour', tap: 'Appuyez pour écouter', stop: 'Arrêter l\'audio', speaking: 'Le narrateur lit en français...', ended: 'Lecture terminée. Jour suivant !', prev: '← Jour précédent', next: 'Jour suivant →' },
    };

    function applyUnlockState(unlocked) {
      isUnlocked = unlocked;
      if (unlocked) {
        if (accessBadge) {
          accessBadge.textContent = '🔓 Full 30-Day Edition Unlocked';
          accessBadge.className = 'font-montserrat text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-emerald-400 text-[#0A1128]';
        }
        if (pdfBadge) {
          pdfBadge.textContent = '🔓 Ready';
          pdfBadge.className = 'text-[10px] font-montserrat font-bold uppercase px-2 py-0.5 rounded bg-emerald-100 text-emerald-800';
        }
        if (pdfBtnIcon) pdfBtnIcon.textContent = '📥';
        if (pdfBtnText) pdfBtnText.textContent = 'Open / Download Full PDF Ebook';
      }
      buildDayGrid();
    }

    async function verifyUnlockCode(codeToTry, silent = false) {
      try {
        const res = await fetch(`/api/ebook?slug=${encodeURIComponent(bookSlug)}&code=${encodeURIComponent(codeToTry)}`);
        const data = await res.json();
        if (res.ok && data.unlocked) {
          localStorage.setItem(storageKey, codeToTry);
          if (codeToTry.toUpperCase() === 'CSA2026') localStorage.setItem(masterStorageKey, 'CSA2026');
          pdfDownloadUrl = data.pdfUrl || pdfDownloadUrl;
          applyUnlockState(true);
          renderCurrentPage();
          return true;
        } else if (!silent && unlockMsg) {
          unlockMsg.textContent = data.error || 'Invalid unlock code.';
          unlockMsg.classList.remove('hidden');
        }
      } catch (e) {
        if (!silent && unlockMsg) {
          unlockMsg.textContent = 'Could not verify code. Please try again.';
          unlockMsg.classList.remove('hidden');
        }
      }
      return false;
    }

    const urlParams = new URLSearchParams(window.location.search);
    const urlUnlockCode = urlParams.get('unlock');
    const savedCode = localStorage.getItem(storageKey) || localStorage.getItem(masterStorageKey);

    if (urlUnlockCode) {
      await verifyUnlockCode(urlUnlockCode, true);
    } else if (savedCode) {
      await verifyUnlockCode(savedCode, true);
    }

    try {
      const mRes = await fetch(`/manuscripts/json/${bookSlug}.json`);
      if (mRes.ok) {
        const mData = await mRes.json();
        if (mData && Array.isArray(mData.pages) && mData.pages.length > 0) {
          pagesData = mData.pages;
          translatedCache.en = pagesData;
        }
      }
    } catch (e) {}

    function buildDayGrid() {
      if (!dayGrid) return;
      dayGrid.innerHTML = '';
      pagesData.forEach((p, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        const locked = !p.isFree && !isUnlocked;
        const label = p.dayNum === 0 ? 'Intro' : `D${p.dayNum}`;
        btn.textContent = locked ? `${label}🔒` : label;

        let cls = 'px-1.5 py-2 rounded-lg font-montserrat text-[11px] font-bold transition-all text-center ';
        if (idx === currentPage) {
          cls += 'bg-[#0A1128] text-[#D4AF37] ring-2 ring-[#D4AF37]';
        } else if (locked) {
          cls += 'bg-gray-100 text-gray-400 hover:bg-gray-200';
        } else {
          cls += 'bg-emerald-50 text-emerald-900 border border-emerald-200 hover:bg-emerald-100';
        }
        btn.className = cls;
        btn.addEventListener('click', () => {
          currentPage = idx;
          renderCurrentPage();
        });
        dayGrid.appendChild(btn);
      });
    }

    function updateSpeakerUI(playing) {
      isPlaying = playing;
      const lbl = uiLabels[currentLang] || uiLabels.en;
      if (playIcon) playIcon.textContent = playing ? '⏹' : '🔊';
      if (playLabel) playLabel.textContent = playing ? lbl.stop : lbl.listen;
      if (cardSpeakIcon) cardSpeakIcon.textContent = playing ? '⏹' : '🔊';
      if (cardSpeakLbl) cardSpeakLbl.textContent = playing ? lbl.stop : lbl.tap;
      if (prevBtn) prevBtn.textContent = lbl.prev;
      if (nextBtn) nextBtn.textContent = lbl.next;
    }

    function stopAudio() {
      sentenceQueue = [];
      sentenceIndex = 0;
      if (window.speechSynthesis) window.speechSynthesis.cancel();
      audioPlayer.pause();
      audioPlayer.removeAttribute('src');
      updateSpeakerUI(false);
    }

    function speakFallback(text) {
      if (!window.speechSynthesis) {
        stopAudio();
        return;
      }
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(text);
      const locales = { en: 'en-US', sv: 'sv-SE', de: 'de-DE', es: 'es-ES', sw: 'sw-TZ', fr: 'fr-FR' };
      u.lang = locales[currentLang] || 'en-US';
      u.rate = 0.92;
      const lbl = uiLabels[currentLang] || uiLabels.en;
      u.onstart = () => {
        updateSpeakerUI(true);
        if (audioStatus) audioStatus.textContent = lbl.speaking;
      };
      u.onend = () => {
        stopAudio();
        if (audioStatus) audioStatus.textContent = lbl.ended;
      };
      u.onerror = () => stopAudio();
      window.speechSynthesis.speak(u);
    }

    // Translate an individual string via GTX or /api/translate
    async function translateSingleField(txt, lang) {
      if (!txt || lang === 'en') return txt;
      try {
        const gUrl = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=${encodeURIComponent(lang)}&dt=t&q=${encodeURIComponent(txt)}`;
        const gRes = await fetch(gUrl);
        if (gRes.ok) {
          const gData = await gRes.json();
          if (Array.isArray(gData) && Array.isArray(gData[0])) {
            return gData[0].map((part) => (part && part[0]) ? part[0] : '').join('');
          }
        }
      } catch (_) {}
      return null;
    }

    async function ensurePageTranslated(lang, pageIdx) {
      if (lang === 'en') return pagesData[pageIdx];
      if (!translatedCache[lang]) translatedCache[lang] = {};
      if (translatedCache[lang][pageIdx]) return translatedCache[lang][pageIdx];

      const orig = pagesData[pageIdx];
      if (!orig) return orig;
      if (translatingIndicator) translatingIndicator.classList.remove('hidden');

      try {
        const flatStrings = [orig.badge, orig.title, orig.subtitle, orig.body, orig.footer];
        // First try client parallel field translation
        let tr = await Promise.all(flatStrings.map((s) => translateSingleField(s, lang)));

        // If any failed (e.g. null), fallback to server /api/translate
        if (tr.some((item) => !item)) {
          const res = await fetch('/api/translate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lang, texts: flatStrings }),
          });
          if (res.ok) {
            const data = await res.json();
            if (data.translated && data.translated.length === 5) {
              tr = data.translated;
            }
          }
        }

        translatedCache[lang][pageIdx] = {
          ...orig,
          badge: (tr && tr[0]) ? tr[0] : orig.badge,
          title: (tr && tr[1]) ? tr[1] : orig.title,
          subtitle: (tr && tr[2]) ? tr[2] : orig.subtitle,
          body: (tr && tr[3]) ? tr[3] : orig.body,
          footer: (tr && tr[4]) ? tr[4] : orig.footer,
        };
      } catch (e) {
        translatedCache[lang][pageIdx] = orig;
      } finally {
        if (translatingIndicator) translatingIndicator.classList.add('hidden');
      }
      return translatedCache[lang][pageIdx];
    }

    // Split long translated text into ~180-char sentence chunks so audio starts in <0.5 seconds and streams paragraph by paragraph in the chosen language!
    function buildAudioChunks(fullText) {
      const cleaned = fullText.replace(/\s+/g, ' ').trim();
      const rawSentences = cleaned.match(/[^.!?]+[.!?]+|\S+/g) || [cleaned];
      const chunks = [];
      let current = '';
      for (const s of rawSentences) {
        if ((current + ' ' + s).trim().length <= 185) {
          current = (current + ' ' + s).trim();
        } else {
          if (current) chunks.push(current);
          if (s.length <= 185) {
            current = s.trim();
          } else {
            // Split very long sentence by words
            const words = s.trim().split(' ');
            let wChunk = '';
            for (const w of words) {
              if ((wChunk + ' ' + w).trim().length <= 185) {
                wChunk = (wChunk + ' ' + w).trim();
              } else {
                if (wChunk) chunks.push(wChunk);
                wChunk = w;
              }
            }
            current = wChunk;
          }
        }
      }
      if (current) chunks.push(current);
      return chunks;
    }

    function playNextSentenceChunk(langForPlayback, fullFallbackText) {
      if (!isPlaying || sentenceIndex >= sentenceQueue.length) {
        const lbl = uiLabels[currentLang] || uiLabels.en;
        stopAudio();
        if (audioStatus) audioStatus.textContent = lbl.ended;
        return;
      }
      const chunkText = sentenceQueue[sentenceIndex];
      sentenceIndex++;
      audioPlayer.src = `/api/swahili-tts?lang=${encodeURIComponent(langForPlayback)}&text=${encodeURIComponent(chunkText)}`;
      audioPlayer.onended = () => {
        playNextSentenceChunk(langForPlayback, fullFallbackText);
      };
      audioPlayer.onerror = () => {
        speakFallback(fullFallbackText);
      };
      audioPlayer.play().catch(() => {
        speakFallback(fullFallbackText);
      });
    }

    async function playCurrentPageAudio() {
      stopAudio();
      const orig = pagesData[currentPage];
      if (!orig || (!orig.isFree && !isUnlocked)) return;

      // Read directly from the visible DOM text (which is already in the selected language!) or translate first
      const p = await ensurePageTranslated(currentLang, currentPage);
      const visibleTitle = (titleEl && titleEl.textContent) ? titleEl.textContent.trim() : p.title;
      const visibleBody = (bodyEl && bodyEl.textContent) ? bodyEl.textContent.trim() : p.body;
      const textToRead = `${visibleTitle}. ${visibleBody}`;
      const lbl = uiLabels[currentLang] || uiLabels.en;

      updateSpeakerUI(true);
      if (audioStatus) audioStatus.textContent = lbl.speaking;

      sentenceQueue = buildAudioChunks(textToRead);
      sentenceIndex = 0;
      playNextSentenceChunk(currentLang, textToRead);
    }

    async function renderCurrentPage() {
      stopAudio();
      const orig = pagesData[currentPage];
      if (!orig) return;

      buildDayGrid();
      updateSpeakerUI(false);

      if (!orig.isFree && !isUnlocked) {
        card?.classList.add('hidden');
        lockCard?.classList.remove('hidden');
        lockCard?.classList.add('flex');
        if (prevBtn) prevBtn.disabled = currentPage === 0;
        if (nextBtn) nextBtn.disabled = currentPage === pagesData.length - 1;
        return;
      }

      lockCard?.classList.add('hidden');
      lockCard?.classList.remove('flex');
      card?.classList.remove('hidden');

      const p = await ensurePageTranslated(currentLang, currentPage);

      if (badgeEl) badgeEl.textContent = p.badge;
      if (counterEl) {
        counterEl.textContent = orig.dayNum === 0 ? `Intro` : `${orig.dayNum} / ${pagesData.length - 1}`;
      }
      if (titleEl) titleEl.textContent = p.title;
      if (subtitleEl) subtitleEl.textContent = p.subtitle;
      if (bodyEl) bodyEl.textContent = p.body;
      if (footerEl) footerEl.textContent = p.footer;

      if (prevBtn) prevBtn.disabled = currentPage === 0;
      if (nextBtn) nextBtn.disabled = currentPage === pagesData.length - 1;

      if (autoReadCheck && autoReadCheck.checked) {
        playCurrentPageAudio();
      }
    }

    langSelect?.addEventListener('change', async () => {
      currentLang = langSelect.value;
      updateSpeakerUI(false);
      await renderCurrentPage();
    });

    prevBtn?.addEventListener('click', () => {
      if (currentPage > 0) {
        currentPage--;
        renderCurrentPage();
      }
    });

    nextBtn?.addEventListener('click', () => {
      if (currentPage < pagesData.length - 1) {
        currentPage++;
        renderCurrentPage();
      }
    });

    playBtn?.addEventListener('click', () => {
      if (isPlaying) stopAudio();
      else playCurrentPageAudio();
    });

    cardSpeakBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isPlaying) stopAudio();
      else playCurrentPageAudio();
    });

    pdfBtn?.addEventListener('click', () => {
      if (isUnlocked) {
        window.open(pdfDownloadUrl, '_blank');
      } else {
        currentPage = 4;
        renderCurrentPage();
      }
    });

    unlockSubmit?.addEventListener('click', async () => {
      const codeVal = (unlockInput?.value || '').trim();
      if (!codeVal) return;
      await verifyUnlockCode(codeVal, false);
    });

    backFreeBtn?.addEventListener('click', () => {
      currentPage = 1;
      renderCurrentPage();
    });

    // Admin / Author Gate Modal logic
    const adminBtn = document.getElementById('idr-admin-btn');
    const gateModal = document.getElementById('idr-gate-modal');
    const gateClose = document.getElementById('idr-gate-close');
    const mathQ = document.getElementById('idr-math-q');
    const mathAns = document.getElementById('idr-math-ans');
    const mathSubmit = document.getElementById('idr-math-submit');
    const step1 = document.getElementById('idr-gate-step1');
    const step2 = document.getElementById('idr-gate-step2');
    const adminBookCode = document.getElementById('idr-admin-book-code');
    const adminMagicUrl = document.getElementById('idr-admin-magic-url');
    const adminUnlockNow = document.getElementById('idr-admin-unlock-now');
    let expectedAns = 9;

    adminBtn?.addEventListener('click', () => {
      const a = Math.floor(Math.random() * 6) + 3;
      const b = Math.floor(Math.random() * 6) + 3;
      expectedAns = a + b;
      if (mathQ) mathQ.textContent = `${a} + ${b} = ?`;
      if (mathAns) mathAns.value = '';
      step1?.classList.remove('hidden');
      step2?.classList.add('hidden');
      gateModal?.classList.remove('hidden');
      gateModal?.classList.add('flex');
    });

    gateClose?.addEventListener('click', () => {
      gateModal?.classList.add('hidden');
      gateModal?.classList.remove('flex');
    });

    mathSubmit?.addEventListener('click', async () => {
      if (parseInt(mathAns?.value || '0', 10) === expectedAns) {
        step1?.classList.add('hidden');
        step2?.classList.remove('hidden');
        try {
          const r = await fetch(`/api/ebook?slug=${encodeURIComponent(bookSlug)}&code=CSA2026`);
          const d = await r.json();
          if (adminBookCode) adminBookCode.textContent = d.bookCode || 'CSA2026';
          if (adminMagicUrl) adminMagicUrl.value = d.magicLink || `${window.location.origin}/books/${bookSlug}/?unlock=CSA2026#interactive-reader`;
        } catch (e) {}
      } else if (mathAns) {
        mathAns.value = '';
        mathAns.placeholder = 'Try again!';
      }
    });

    adminUnlockNow?.addEventListener('click', async () => {
      await verifyUnlockCode('CSA2026', true);
      gateModal?.classList.add('hidden');
      gateModal?.classList.remove('flex');
    });

    await renderCurrentPage();
  });
</script>
